generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTHENTIFICATION (better-auth)
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  phone         String?
  role          String    @default("client")
  avatar        String?
  location      String?
  country       String?
  bio           String?
  isVerified    Boolean   @default(false)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  image         String?

  // Relations
  artisan       Artisan?
  missions      Mission[]
  bookings      Booking[]
  lastActiveAt  DateTime? @default(now())
  referralCode  String?  @unique
  referralsMade Referral[] @relation("ReferralsMade")
  referredBy    Referral?  @relation("ReferralsReceived")
  accounts      Account[]
  sessions      Session[]
  reviews       Review[]
  sentMessages  Message[]  @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  payments      Payment[]
  favorites     Favorite[]
  supportTickets SupportTicket[]
  socialPosts   SocialPost[]
  postComments  SocialComment[]
  postReactions SocialReaction[]
  savedPosts    SavedSocialPost[]
  stories       SocialStory[]
  reports       ContentReport[] @relation("ReporterReports")
  moderatedReports ContentReport[] @relation("ModeratorReports")
  quotesRequested Quote[] @relation("ClientQuotes")

  @@index([location])
  @@index([role])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String   @default("")
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  userId    String   @default("")

  @@index([userId])
}

// ============================================
// ARTISAN
// ============================================

model Artisan {
  id             String   @id @default(cuid())
  userId         String   @unique
  profession     String?
  specialties    String   @default("[]")
  skills         String   @default("[]")
  hourlyRate     Int      @default(0)
  experience     Int      @default(0)
  badge          String   @default("Nouveau")
  isPremium      Boolean  @default(false)
  premiumUntil   DateTime?
  identityDocument String?
  identityStatus   String  @default("non_soumis")
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  missionCount   Int      @default(0)
  isAvailable    Boolean  @default(true)
  portfolio      String   @default("[]")
  certifications String   @default("[]")
  teamMembers    String   @default("[]")
  latitude       Float?
  longitude      Float?
  address        String?
  country        String?
  location       String?
  phone          String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews        Review[]
  missions       Mission[]
  bookings       Booking[]
  favorites      Favorite[] 
   payments       Payment[]  
   quotes         Quote[]
   stories        SocialStory[]

  @@index([latitude])
  @@index([longitude])
  @@index([isAvailable])
}

// ============================================
// CATÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â°GORIES DE MÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â°TIERS
// ============================================

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @default("")
  icon         String?
  description  String?
  artisanCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================
// MISSIONS (demandes client ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ artisan)
// ============================================

model Mission {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  status      String   @default("ouverte")
  disputeReason String?
  budget      Int      @default(0)
  location    String?
  latitude    Float?
  longitude   Float?
  clientId    String
  artisanId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client      User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  artisan     Artisan? @relation(fields: [artisanId], references: [id])
  reviews     Review[]
  payments    Payment[]
  messages    Message[]
  milestones  MissionMilestone[]
  quote       Quote?

  @@index([status])
  @@index([clientId])
  @@index([artisanId])
}

// ============================================
// AVIS / REVIEWS (client note l'artisan)
// ============================================

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1 ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â  5 ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â©toiles
  comment   String?
  clientId  String
  artisanId String
  missionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client    User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  artisan   Artisan  @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([artisanId])
  @@index([clientId])
}

// ============================================
// MESSAGES / CHAT (entre client et artisan)
// ============================================

model Message {
  id         String   @id @default(cuid())
  content    String
  type       String   @default("text")
  senderId   String
  receiverId String
  missionId  String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relations
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  mission    Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([missionId])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, mission, payment
  isRead    Boolean  @default(false)
  link      String?  // lien vers la mission, le paiement, etc.
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// ============================================
// WEB PUSH SUBSCRIPTIONS
// ============================================

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  ua         String?  // user agent / device info
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// PAIEMENTS
// ============================================

model Payment {
  id            String   @id @default(cuid())
  amount        Int
  netAmount     Int?
  commission    Int      @default(0)
  currency      String   @default("XAF")
  status        String   @default("en_attente")
  method        String?
  type          String   @default("mission")
  reference     String?
  phoneNumber   String?
  description   String?
  recipientId   String?
  recipientName String?
  kkiapayTransactionId String?
  cinetPayTransId      String?
  metadata      String?
  clientId      String
  artisanId     String?
  missionId     String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  client        User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  artisan       Artisan? @relation(fields: [artisanId], references: [id])
  mission       Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  milestoneId   String?

  @@index([clientId])
  @@index([artisanId])
  @@index([missionId])
  @@index([status])
}

// ============================================
// FAVORIS (client sauvegarde un artisan)
// ============================================

model Favorite {
  id        String   @id @default(cuid())
  clientId  String
  artisanId String
  createdAt DateTime @default(now())

  // Relations
  client    User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  artisan   Artisan  @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@unique([clientId, artisanId]) // un client ne peut pas favoriser 2 fois le mÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Âªme artisan
  @@index([clientId])
  @@index([artisanId])
}

// ============================================
// RESERVATIONS (rendez-vous client <-> artisan)
// ============================================

model SocialPost {
  id        String   @id @default(cuid())
  authorId  String
  content   String
  title     String?
  category  String?
  location  String?
  mediaUrls String[] @default([])
  mediaTypes String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  SocialComment[]
  reactions SocialReaction[]
  savedBy   SavedSocialPost[]

  @@index([authorId])
  @@index([createdAt])
}

model SocialComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([authorId])
}

model SocialReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model Quote {
  id          String   @id @default(cuid())
  missionId   String?  @unique
  clientId    String
  artisanId   String
  title       String
  description String?
  amount      Int      @default(0)
  currency    String   @default("XAF")
  status      String   @default("en_attente") // en_attente | accepte | refuse | expire
  validUntil  DateTime?
  artisanNote String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  mission     Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  client      User     @relation("ClientQuotes", fields: [clientId], references: [id], onDelete: Cascade)
  artisan     Artisan  @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([artisanId])
  @@index([status])
}

model SavedSocialPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}

model SocialStory {
  id        String   @id @default(cuid())
  authorId  String
  artisanId String
  mediaUrl  String
  mediaType String   @default("image")
  caption   String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  author    User    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  artisan   Artisan @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@index([artisanId])
  @@index([expiresAt])
}

model ContentReport {
  id          String   @id @default(cuid())
  reporterId  String
  postId      String?
  commentId   String?
  reason      String
  details     String?
  status      String   @default("ouvert") // ouvert | examine | resolu | rejete
  moderatorId String?
  resolution  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter    User  @relation("ReporterReports", fields: [reporterId], references: [id], onDelete: Cascade)
  moderator   User? @relation("ModeratorReports", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([reporterId])
  @@index([postId])
}

model MissionMilestone {
  id          String   @id @default(cuid())
  missionId   String
  title       String
  description String?
  amount      Int
  status      String   @default("en_attente") // en_attente | paye | termine
  dueAt       DateTime?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  mission     Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  @@index([missionId])
  @@index([status])
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  subject     String
  message     String
  category    String   @default("general")
  status      String   @default("ouvert") // ouvert | en_cours | resolu
  response    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([status])
}

model Booking {
  id           String   @id @default(cuid())
  clientId     String
  artisanId    String?
  service      String
  category     String?
  date         DateTime
  status       String   @default("en_attente") // en_attente | confirmee | terminee | annulee
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  client       User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  artisan      Artisan? @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([artisanId])
  @@index([date])
  @@index([status])
}




// ============================================
// PARRAINAGE
// ============================================

model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  refereeId     String   @unique
  creditsEarned Int      @default(500)
  createdAt     DateTime @default(now())

  referrer User @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("ReferralsReceived", fields: [refereeId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

