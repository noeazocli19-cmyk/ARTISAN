generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// AUTHENTIFICATION (better-auth)
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?
  phone         String?
  role          String    @default("client")
  avatar        String?
  location      String?
  country       String?
  bio           String?
  isVerified    Boolean   @default(false)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  image         String?

  // Relations
  artisan       Artisan?
  missions      Mission[]
  bookings      Booking[]
  accounts      Account[]
  sessions      Session[]
  reviews       Review[]
  sentMessages  Message[]  @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  notifications Notification[]
  payments      Payment[]
  favorites     Favorite[]

  @@index([location])
  @@index([role])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  email     String   @default("")
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  userId    String   @default("")

  @@index([userId])
}

// ============================================
// ARTISAN
// ============================================

model Artisan {
  id             String   @id @default(cuid())
  userId         String   @unique
  profession     String?
  specialties    String   @default("[]")
  skills         String   @default("[]")
  hourlyRate     Int      @default(0)
  experience     Int      @default(0)
  badge          String   @default("Nouveau")
  rating         Float    @default(0)
  reviewCount    Int      @default(0)
  missionCount   Int      @default(0)
  isAvailable    Boolean  @default(true)
  portfolio      String   @default("[]")
  certifications String   @default("[]")
  latitude       Float?
  longitude      Float?
  address        String?
  country        String?
  location       String?
  phone          String?
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviews        Review[]
  missions       Mission[]
  bookings       Booking[]
  favorites      Favorite[] 
   payments       Payment[]  

  @@index([latitude])
  @@index([longitude])
  @@index([isAvailable])
}

// ============================================
// CATÃ‰GORIES DE MÃ‰TIERS
// ============================================

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @default("")
  icon         String?
  description  String?
  artisanCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============================================
// MISSIONS (demandes client â†’ artisan)
// ============================================

model Mission {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  status      String   @default("ouverte")
  budget      Int      @default(0)
  location    String?
  latitude    Float?
  longitude   Float?
  clientId    String
  artisanId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  client      User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  artisan     Artisan? @relation(fields: [artisanId], references: [id])
  reviews     Review[]
  payments    Payment[]
  messages    Message[]

  @@index([status])
  @@index([clientId])
  @@index([artisanId])
}

// ============================================
// AVIS / REVIEWS (client note l'artisan)
// ============================================

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1 Ã  5 Ã©toiles
  comment   String?
  clientId  String
  artisanId String
  missionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  client    User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  artisan   Artisan  @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  mission   Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([artisanId])
  @@index([clientId])
}

// ============================================
// MESSAGES / CHAT (entre client et artisan)
// ============================================

model Message {
  id         String   @id @default(cuid())
  content    String
  senderId   String
  receiverId String
  missionId  String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relations
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  mission    Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([missionId])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // info, success, warning, mission, payment
  isRead    Boolean  @default(false)
  link      String?  // lien vers la mission, le paiement, etc.
  createdAt DateTime @default(now())

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

// ============================================
// PAIEMENTS
// ============================================

model Payment {
  id            String   @id @default(cuid())
  amount        Int      // montant en FCFA ou devise
  currency      String   @default("XAF")
  status        String   @default("en_attente") // en_attente, payÃ©, Ã©chouÃ©, remboursÃ©
  method        String?  // Mobile Money, Orange Money, carte, etc.
  reference     String?  // rÃ©fÃ©rence de transaction
  clientId      String
  artisanId     String?
  missionId     String?
  paidAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  client        User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  artisan       Artisan? @relation(fields: [artisanId], references: [id])
  mission       Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([artisanId])
  @@index([missionId])
  @@index([status])
}

// ============================================
// FAVORIS (client sauvegarde un artisan)
// ============================================

model Favorite {
  id        String   @id @default(cuid())
  clientId  String
  artisanId String
  createdAt DateTime @default(now())

  // Relations
  client    User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  artisan   Artisan  @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@unique([clientId, artisanId]) // un client ne peut pas favoriser 2 fois le mÃªme artisan
  @@index([clientId])
  @@index([artisanId])
}

// ============================================
// RESERVATIONS (rendez-vous client <-> artisan)
// ============================================

model Booking {
  id           String   @id @default(cuid())
  clientId     String
  artisanId    String
  service      String
  date         DateTime
  status       String   @default("en_attente") // en_attente | confirmee | terminee | annulee
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  client       User     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  artisan      Artisan  @relation(fields: [artisanId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([artisanId])
  @@index([date])
  @@index([status])
}

